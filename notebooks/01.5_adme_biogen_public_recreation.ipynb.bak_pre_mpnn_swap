    "def max_neighbor_sims(fps, sim_fn):\n",
    "    \"\"\"For each fingerprint, return its max similarity to any other fingerprint in the same list (self excluded).\"\"\"\n",
    "    maxes = np.empty(len(fps))\n",
    "    for i in range(len(fps)):\n",
    "        sims = np.array(sim_fn(fps[i], fps))\n",
    "        sims[i] = -np.inf  # exclude self-similarity (always 1.0)\n",
    "        maxes[i] = sims.max()\n",
    "    return maxes\n",
    "\n",
    "fcfp4_dice_max = max_neighbor_sims(fcfp4_fps, DataStructs.BulkDiceSimilarity)\n",
    "fcfp4_tanimoto_max = max_neighbor_sims(fcfp4_fps, DataStructs.BulkTanimotoSimilarity)\n",
    "ecfp4_dice_max = max_neighbor_sims(ecfp4_fps, DataStructs.BulkDiceSimilarity)\n",
    "ecfp4_tanimoto_max = max_neighbor_sims(ecfp4_fps, DataStructs.BulkTanimotoSimilarity)\n",
    "\n",
    "# Same encoding as §2.2: colour = metric (Dice=blue, Tanimoto=orange), style = fingerprint (FCFP4 solid, ECFP4 dotted)\n",
    "max_series = [\n",
    "    ('FCFP4 Dice',     fcfp4_dice_max,     'steelblue',  'solid'),\n",
    "    ('ECFP4 Dice',     ecfp4_dice_max,     'steelblue',  'dot'),\n",
    "    ('FCFP4 Tanimoto', fcfp4_tanimoto_max, 'darkorange', 'solid'),\n",
    "    ('ECFP4 Tanimoto', ecfp4_tanimoto_max, 'darkorange', 'dot'),\n",
    "]"
