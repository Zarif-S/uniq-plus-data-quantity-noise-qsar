    "# Section 4.3b -- evaluate the TUNED models (arm='tuned'), appended to the same section4_* checkpoint.\n",
    "def compute_one_tuned(key):\n",
    "    ep, fs, model_name, arm = key\n",
    "    best = dict(tuned_params[_tkey(ep, fs, model_name)])\n",
    "    best.pop('_mode', None)\n",
    "    if model_name in MPNN_NAMES:\n",
    "        base = splits[(ep, 'fcfp4')]\n",
    "        smi_tr = np.asarray(base['smiles_train'], dtype=object)\n",
    "        smi_te = np.asarray(base['smiles_test'],  dtype=object)\n",
    "        y_train, y_test = base['y_train'], base['y_test']\n",
    "        mode_kw = _MPNN_KW[model_name]\n",
    "        use_feat = mode_kw.get('use_features', False)\n",
    "        if use_feat:\n",
    "            rd = splits[(ep, MPNN_FEATURE_SOURCE[model_name])]\n",
    "            X_train = np.column_stack([smi_tr, rd['X_train_qt']]).astype(object)\n",
