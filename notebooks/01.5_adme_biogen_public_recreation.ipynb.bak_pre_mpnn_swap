    "# Section 4.2b -- MPNN1 & MPNN2, appended to the SAME checkpoint as Section 4.2.\n",
    "# 'sample' is a fast undertrained preview; 'full' is the real 5x3 / 30-epoch run.\n",
    "MPNN_MODE = 'full'  # 'full' or 'sample'\n",
    "MPNN_CV = {\n",
    "    'full':   dict(n_splits=5, n_repeats=3, epochs=30),   # ~100 min\n",
    "    'sample': dict(n_splits=2, n_repeats=1, epochs=20),   # ~10 min preview\n",
    "}\n",
    "MPNN_MODE_RANK = {'sample': 0, 'full': 1}  # 'full' supersedes 'sample'\n",
    "\n",
    "# (model, featureset-label, ChempropRegressor feature-mode kwargs) for the graph models.\n",
    "# MPNN1 graph-only; MPNN2 external rmoldes (316) via X; MPNN3 ChemProp-generated rdkit_2d_normalized (200).\n",
    "MPNN_SPECS = [('MPNN1', 'graph', {}),\n",
    "              ('MPNN2', 'graph_rdkit', {'use_features': True}),\n",
    "              ('MPNN3', 'graph_rdkit2dnorm', {'features_generator': 'rdkit_2d_normalized'}),\n",
    "              ('MPNN4', 'graph_rdkit2d_raw', {'use_features': True})]\n",
    "_MPNN_KW = {name: kw for name, fs, kw in MPNN_SPECS}     # name -> feature-mode kwargs\n",
    "MPNN_NAMES = [name for name, fs, kw in MPNN_SPECS]\n",
    "# use_features models read their external descriptor block from this split key (row-aligned via §4.1):\n",
    "# MPNN2 -> rmoldes (316); MPNN4 -> un-normalized rdkit_2d (200). Both QuantileTransformer-uniform.\n",
    "MPNN_FEATURE_SOURCE = {'MPNN2': 'rdkit', 'MPNN4': 'rdkit2d_raw'}\n",
    "\n",
    "def compute_one_mpnn(key):\n",
    "    ep, fs, model_name, arm = key\n",
    "    mode_kw = _MPNN_KW[model_name]\n",
    "    use_features = mode_kw.get('use_features', False)\n",
    "    # SMILES + y are identical across featuresets for an endpoint, so read from 'fcfp4';\n",
    "    # external descriptor features come from MPNN_FEATURE_SOURCE[model] (QuantileTransformer-uniform,\n",
    "    # see DECISIONS.md) and stay row-aligned with the shared fcfp4 SMILES.\n",
    "    base = splits[(ep, 'fcfp4')]\n",
    "    smiles_train = np.asarray(base['smiles_train'], dtype=object)\n",
    "    smiles_test  = np.asarray(base['smiles_test'],  dtype=object)\n",
    "    y_train, y_test = base['y_train'], base['y_test']\n",
    "\n",
    "    if use_features:\n",
    "        rd = splits[(ep, MPNN_FEATURE_SOURCE[model_name])]\n",
    "        X_train = np.column_stack([smiles_train, rd['X_train_qt']]).astype(object)\n",
    "        X_test  = np.column_stack([smiles_test,  rd['X_test_qt']]).astype(object)\n",
    "    else:\n",
    "        X_train, X_test = smiles_train.reshape(-1, 1), smiles_test.reshape(-1, 1)\n",
    "\n",
    "    cfg = MPNN_CV[MPNN_MODE]\n",
    "    m = clone(ChempropRegressor(**param_base_MPNN, **mode_kw,\n",
    "                                epochs=cfg['epochs'], random_state=42))\n",
    "    result = model_validation(m, X_train, y_train, X_test, y_test,\n",
    "                              n_splits=cfg['n_splits'], n_repeats=cfg['n_repeats'], n_jobs=1)\n",
    "    row = {\n",
    "        'endpoint': ep, 'featureset': fs, 'model': model_name, 'arm': arm,\n",
    "        'mpnn_mode': MPNN_MODE,\n",
    "        'Pearson_r_CV':   result['Pearson_r_CV'],\n",
