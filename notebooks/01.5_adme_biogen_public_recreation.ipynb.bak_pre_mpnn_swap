    "# Canonicalise CSV SMILES through the SAME standardize() used for the SDF, then compare per endpoint.\n",
    "from rdkit import RDLogger\n",
    "RDLogger.DisableLog('rdApp.*')\n",
    "\n",
    "def _csv_canon(smi):\n",
    "    m = Chem.MolFromSmiles(smi)\n",
    "    return Chem.MolToSmiles(standardize(m)) if m is not None else None\n",
    "\n",
    "csv_canon = df['SMILES'].map(_csv_canon)\n",
    "n_unparsed = int(csv_canon.isna().sum())\n",
    "\n",
    "rows = []\n",
    "for ep, col in ENDPOINTS.items():\n",
    "    csv_set = set(csv_canon[df[col].notna()].dropna())\n",
    "    sdf_set = set(df_sdf.loc[df_sdf[col].notna(), 'can_smi'])\n",
