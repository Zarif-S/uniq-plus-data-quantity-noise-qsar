    "      f'Already-cached keys are skipped.')\n",
    "\n",
    "# --- classical + FCNN: per (endpoint, featureset in TUNE_FEATURESETS) ---\n",
    "for ep in MODEL_ENDPOINTS:\n",
    "    for fs in TUNE_FEATURESETS:\n",
    "        split = splits[(ep, fs)]\n",
    "        y_train = split['y_train']\n",
    "        for model_name in TUNE_CLASSICAL:\n",
    "            key = _tkey(ep, fs, model_name)\n",
    "            if key in tuned_params:\n",
    "                print(f'skip {key}'); continue\n",
    "            Xtr = split['X_train_scaled'] if model_name in SCALED_MODELS else split['X_train']\n",
    "            m = clone(paper_models[model_name])\n",
    "            tune_paper_model(m, Xtr, y_train, PARAM_GRID_STAGES[model_name], n_jobs_cv=n_jobs_cv)\n",
    "            grid_keys = set().union(*[set(stage) for stage in PARAM_GRID_STAGES[model_name]])\n",
    "            _save_tuned(key, {k: m.get_params()[k] for k in grid_keys})\n",
    "        # FCNN: pick the best of the 5 architectures by train-only CV Pearson r (only when TUNE_FCNN)\n",
    "        if TUNE_FCNN:\n",
    "            fkey = _tkey(ep, fs, 'FCNN')\n",
    "            if fkey in tuned_params:\n",
    "                print(f'skip {fkey}')\n",
    "            else:\n",
    "                best_fcnn, _scores = tune_fcnn_architecture(\n",
    "                    split['X_train_scaled'], y_train, FCNN_ARCHITECTURES, param_base_FCNN, n_jobs=1)  # FCNN=torch: serial CV (ADR-008)\n",
    "                _save_tuned(fkey, {'hidden_layers': best_fcnn['hidden_layers'], 'dropout': best_fcnn['dropout']})\n",
    "\n",
    "# --- MPNN1/MPNN2: per endpoint (own graph featuresets); trials by MPNN_MODE; full supersedes sample ---\n",
    "for ep in MODEL_ENDPOINTS:\n",
    "    base = splits[(ep, 'fcfp4')]                 # smiles/y identical across featuresets\n",
    "    smi_train = np.asarray(base['smiles_train'], dtype=object)\n",
    "    for model_name, fs, _kw in MPNN_SPECS:\n",
    "        if model_name not in MPNN_TUNE_MODELS:\n",
    "            continue\n",
    "        use_feat = _kw.get('use_features', False)\n",
    "        key = _tkey(ep, fs, model_name)\n",
    "        cached = tuned_params.get(key)\n",
    "        if cached and MPNN_MODE_RANK.get(cached.get('_mode', 'sample'), 0) >= MPNN_MODE_RANK[MPNN_MODE]:\n",
    "            print(f\"skip {key} (mode {cached.get('_mode')})\"); continue\n",
    "        if use_feat:\n",
    "            X = np.column_stack([smi_train, splits[(ep, MPNN_FEATURE_SOURCE[model_name])]['X_train_qt']]).astype(object)\n",
    "        else:\n",
    "            X = smi_train.reshape(-1, 1)\n",
    "        best = tune_mpnn_hyperopt(X, base['y_train'], **_kw,\n",
    "                                  num_iters=MPNN_TUNE_ITERS[MPNN_MODE], epochs=MPNN_CV[MPNN_MODE]['epochs'])\n",
    "        best['_mode'] = MPNN_MODE\n",
    "        _save_tuned(key, best)\n",
    "\n",
