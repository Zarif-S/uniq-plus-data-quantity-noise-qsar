    "# to a JSON cache, skipping keys already present so an interrupted overnight run resumes. Decoupled\n",
    "# from eval (4.3b consumes the cache). Expensive: staged GridSearchCV (classical), 5-arch CV (FCNN),\n",
    "# ChemProp hyperopt (MPNN). Uses n_jobs_cv, splits, MODEL_ENDPOINTS, MPNN_CV/MPNN_MODE from above.\n",
    "TUNED_PARAMS_PATH = DATA_PROC / 'section4_tuned_params.json'\n",
    "TUNE_FEATURESETS = ['hybrid']                # tune on hybrid ONLY (base arm §4.2 still evaluates all 5 featuresets; §5.6 tuning fig uses hybrid). Set = FEATURESETS to tune everything.\n",
    "TUNE_CLASSICAL   = ['RF', 'LightGBM']       # tuned arm: RF + LightGBM only\n",
    "SCALED_MODELS    = ('SVM', 'Lasso', 'BayesianRidge', 'FCNN')\n",
    "MPNN_TUNE_ITERS  = {'full': 20, 'sample': 3}   # ChemProp hyperopt trials, by MPNN_MODE\n",
    "MPNN_MODE_RANK   = {'sample': 0, 'full': 1}    # 'full' supersedes 'sample'\n",
    "MPNN_TUNE_MODELS = ['MPNN1', 'MPNN3']          # tune graph-only MPNN1 + paper-faithful MPNN3 (not MPNN2/QT)\n",
    "TUNE_FCNN        = False                       # FCNN excluded from the tuned arm this run\n",
    "\n",
    "def _tkey(ep, fs, model):\n",
    "    return f'{ep}|{fs}|{model}'\n",
    "\n",
    "def _parse_tkey(tk):\n",
    "    ep, fs, model = tk.split('|')\n",
    "    return ep, fs, model\n",
    "\n",
    "tuned_params = json.load(open(TUNED_PARAMS_PATH)) if TUNED_PARAMS_PATH.exists() else {}\n",
    "\n",
    "def _save_tuned(key, params):\n",
    "    tuned_params[key] = params\n",
    "    with open(TUNED_PARAMS_PATH, 'w') as f:\n",
    "        json.dump(tuned_params, f, indent=2)\n",
    "    shown = {k: v for k, v in params.items() if not k.startswith('_')}\n",
    "    print(f'tuned {key}: {shown}')\n",
    "\n",
    "paper_models = get_paper_models()\n",
    "\n",
    "# fit-count estimate so it's clear why tuning is slow from fresh (staged GridSearch, cv=5)\n",
    "from math import prod\n",
    "classical_fits_per_model = {m: sum(prod(len(v) for v in stage.values()) for stage in PARAM_GRID_STAGES[m]) for m in TUNE_CLASSICAL}\n",
    "classical_fits = sum(classical_fits_per_model.values()) * 5 * len(MODEL_ENDPOINTS) * len(TUNE_FEATURESETS)\n",
    "mpnn_trainings = MPNN_TUNE_ITERS[MPNN_MODE] * len(MPNN_TUNE_MODELS) * len(MODEL_ENDPOINTS)\n",
    "print(f'Tuning scope: classical {TUNE_CLASSICAL} on {TUNE_FEATURESETS} (~{classical_fits} GridSearch fits), '\n",
