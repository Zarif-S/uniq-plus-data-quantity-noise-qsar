    "# Section 4.2 -- checkpointed base eval loop.\n",
    "# run_checkpointed_eval skips any (ep, fs, model, arm) key already present in the on-disk\n",
    "# predictions checkpoint, so re-running only computes MISSING keys (e.g. after adding a model).\n",
    "# To force a recompute of specific keys, use invalidate_checkpoint(RESULTS_CSV, PREDICTIONS_PKL,\n",
    "# **filters) -- it drops matching keys from BOTH files. e.g. after changing param_base_RF:\n",
    "#     invalidate_checkpoint(RESULTS_CSV, PREDICTIONS_PKL, model='RF')   # then re-run this cell\n",
    "# NOTE: manual cache invalidation -- the loop skips a key because it EXISTS, not because it's\n",
    "# still valid, so if a model's *definition* changes you must invalidate its keys or results go stale.\n",
    "#\n",
    "# This loop runs the 'base' arm ONLY (ARMS=('base',)): paper's param_base_* defaults + model_validation.\n",
    "# The 'tuned' arm is produced separately in Section 4.3 (tune -> eval), never here.\n",
    "# Metrics: Pearson_r_CV, Pearson_r_test, MAE. cv_scores (the 15 RepeatedKFold folds) are persisted\n",
    "# so Section 5's boxplots have a real per-model/featureset distribution. n_jobs=n_jobs_cv\n",
    "# parallelizes the 15 folds inside model_validation.\n",
    "\n",
    "RESULTS_CSV     = DATA_PROC / 'section4_paper_recreation_results.csv'\n",
    "PREDICTIONS_PKL = DATA_PROC / 'section4_test_predictions.pkl'\n",
    "ARMS = ('base',)  # BASE-eval arms only. The 'tuned' arm is produced independently by 4.3b\n",
    "                  # (arm='tuned' hardcoded from tuned_params) — do NOT add 'tuned' here, or\n",
    "                  # the base cells would recompute it with UNtuned params.\n",
    "\n",
    "paper_models = get_paper_models()\n",
    "\n",
    "def compute_one(key):\n",
    "    ep, fs, model_name, arm = key\n",
    "    split = splits[(ep, fs)]\n",
    "    if model_name in ('SVM', 'Lasso', 'BayesianRidge', 'FCNN'):\n",
    "        X_train, X_test = split['X_train_scaled'], split['X_test_scaled']\n",
    "    else:\n",
    "        X_train, X_test = split['X_train'], split['X_test']\n",
    "    y_train, y_test = split['y_train'], split['y_test']\n",
    "\n",
    "    m = clone(paper_models[model_name])  # fresh unfitted copy per key; base arm only (tuning -> 4.3)\n",
    "    result = model_validation(m, X_train, y_train, X_test, y_test, n_jobs=1 if model_name == 'FCNN' else n_jobs_cv)  # FCNN=torch: serial CV (ADR-008)\n",
    "    row = {\n",
    "        'endpoint': ep, 'featureset': fs, 'model': model_name, 'arm': arm,\n",
    "        'Pearson_r_CV':   result['Pearson_r_CV'],\n",
    "        'Pearson_r_test': result['Pearson_r_test'],\n",
    "        'MAE':            mae(y_test, result['y_pred_test']),\n",
    "    }\n",
    "    pred = {'y_test': y_test, 'y_pred_test': result['y_pred_test'], 'cv_scores': result['cv_scores']}\n",
    "    return row, pred\n",
    "\n",
    "keys = [(ep, fs, model_name, arm)\n",
    "        for ep in MODEL_ENDPOINTS\n",
    "        for fs in FEATURESETS\n",
    "        for model_name in paper_models\n",
    "        for arm in ARMS]\n",
    "\n",
    "FOLDS = 5 * 3  # RepeatedKFold(5x3) inside model_validation -> cv_scores length\n",
    "print(f'Section 4.2 base eval: {len(keys)} (ep, fs, model) keys x {FOLDS} CV folds = up to '\n",
    "      f'{len(keys) * FOLDS} CV fits from fresh (+1 full-train fit per key); checkpointed -> only missing keys compute.')\n",
    "results_df, predictions = run_checkpointed_eval(keys, compute_one, RESULTS_CSV, PREDICTIONS_PKL)\n",
    "print(results_df.shape)\n",
    "results_df.head()"
   ]
