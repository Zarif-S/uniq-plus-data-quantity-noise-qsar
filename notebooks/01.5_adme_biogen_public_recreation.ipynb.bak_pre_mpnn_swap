   "source": [
    "# --- Section 4.1a: inspect the rdkit (rdMolDes, 316) descriptor distributions ---\n",
    "# Reuses the already-built splits: X_train (raw) vs X_train_scaled (RobustScaler) vs X_train_qt (QT).\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import skew, kurtosis\n",
    "\n",
    "INSPECT_EP = 'HLM'   # any model endpoint; distributions are qualitatively the same across the four\n",
    "\n",
    "# Reconstruct rdMolDes column names in the exact order features.rdmoldes() builds them (44 scalar + 272 vector).\n",
    "scalar_names = [\n",
    "    'TPSA', 'FractionCSP3', 'NumAliphaticCarbocycles', 'NumAliphaticHeterocycles', 'NumAliphaticRings',\n",
    "    'NumAmideBonds', 'NumAromaticCarbocycles', 'NumAromaticHeterocycles', 'NumAromaticRings',\n",
    "    'NumLipinskiHBA', 'NumLipinskiHBD', 'NumHeteroatoms', 'NumRings', 'NumRotatableBonds',\n",
    "    'NumSaturatedCarbocycles', 'NumSaturatedHeterocycles', 'NumSaturatedRings', 'HallKierAlpha',\n",
    "    'Kappa1', 'Kappa2', 'Kappa3', 'Chi0n', 'Chi0v', 'Chi1n', 'Chi1v', 'Chi2n', 'Chi2v', 'Chi3n', 'Chi3v',\n",
    "    'Chi4n', 'Chi4v', 'Asphericity', 'Eccentricity', 'InertialShapeFactor', 'ExactMolWt', 'PBF',\n",
    "    'PMI1', 'PMI2', 'PMI3', 'RadiusOfGyration', 'SpherocityIndex', 'LabuteASA', 'NPR1', 'NPR2',\n",
    "]\n",
    "peoe_vsa_names = [f'PEOE_VSA_{i}' for i in range(1, 15)]\n",
    "smr_vsa_names = [f'SMR_VSA_{i}' for i in range(1, 11)]\n",
    "slogp_vsa_names = [f'SlogP_VSA_{i}' for i in range(1, 13)]\n",
    "mqn_names = [f'MQN_{i}' for i in range(1, 43)]\n",
    "crippen_names = ['Crippen_LogP', 'Crippen_MR']\n",
    "autocorr2d_names = [f'AUTOCORR2D_{i}' for i in range(1, 193)]\n",
    "vector_names = peoe_vsa_names + smr_vsa_names + slogp_vsa_names + mqn_names + crippen_names + autocorr2d_names\n",
    "feat_names = scalar_names + vector_names\n",
    "assert len(feat_names) == 316, len(feat_names)\n",
    "\n",
    "X_raw = splits[(INSPECT_EP, 'rdkit')]['X_train']          # raw rdMolDes (what trees see)\n",
    "X_rs  = splits[(INSPECT_EP, 'rdkit')]['X_train_scaled']   # RobustScaler (SVM/Lasso/BayesianRidge/FCNN)\n",
    "X_qt  = splits[(INSPECT_EP, 'rdkit')]['X_train_qt']       # QuantileTransformer-uniform (MPNN2)\n",
    "\n",
    "# --- Panel A: the population of 316 features (skew, kurtosis, scale) ---\n",
    "skews = skew(X_raw, axis=0)\n",
    "kurts = kurtosis(X_raw, axis=0)          # excess kurtosis (0 = normal)\n",
    "stds  = X_raw.std(axis=0)\n",
    "\n",
    "n_heavy = int(np.sum(np.abs(skews) > 2))\n",
    "n_const = int(np.sum(stds == 0))\n",
    "print(f'[{INSPECT_EP}] rdMolDes X_train: {X_raw.shape[0]} molecules x {X_raw.shape[1]} descriptors')\n",
    "print(f'  heavy-tailed (|skew|>2): {n_heavy}/316    near-constant (std==0): {n_const}/316')\n",
    "print(f'  per-feature std spans {stds[stds>0].min():.2e} .. {stds.max():.2e} '\n",
    "      f'({np.log10(stds.max()/stds[stds>0].min()):.1f} orders of magnitude)')\n",
    "print(f'  most right-skewed: ' + ', '.join(f'{feat_names[i]}({skews[i]:.0f})'\n",
    "      for i in np.argsort(skews)[-5:][::-1]))\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 3.6))\n",
    "axes[0].hist(skews, bins=40, color='steelblue', edgecolor='white')\n",
    "axes[0].axvline(2, color='crimson', ls='--', lw=1)\n",
    "axes[0].axvline(-2, color='crimson', ls='--', lw=1)\n",
    "axes[0].set_title('Per-feature skewness')\n",
    "axes[0].set_xlabel('skew')\n",
    "axes[0].set_ylabel('# features')\n",
    "# Excess kurtosis spans 0..~1600, so plot on a log10(x+1) axis but RELABEL ticks back to raw values,\n",
    "# and mark two references: exkurt=3 (Laplace tails) and ~2x ExactMolWt (see below).\n",
    "exkurt_clip = np.clip(kurts, 0, None)          # mild sub-normal (<0) squashed to 0; we care about heavy tails\n",
    "axes[1].hist(np.log10(exkurt_clip + 1), bins=40, color='seagreen', edgecolor='white')\n",
    "raw_ticks = [0, 1, 3, 10, 100, 1000]\n",
    "axes[1].set_xticks([np.log10(t + 1) for t in raw_ticks])\n",
    "axes[1].set_xticklabels(raw_ticks)\n",
    "# Two reference lines: Laplace (double-exponential, a named heavy-tailed benchmark) = exkurt 3; and\n",
    "# ~2x ExactMolWt's kurtosis -- ExactMolWt (exkurt 5, shown in Panel B) is a feature you can eyeball there,\n",
    "# so the 'outlier-dominated' mark is anchored to something visible rather than asserted.\n",
    "molwt_k = kurts[feat_names.index('ExactMolWt')]\n",
    "reference_lines = [(3, 'Laplace'), (2 * molwt_k, '~2x ExactMolWt')]\n",
    "for thr, lbl in reference_lines:\n",
    "    axes[1].axvline(np.log10(thr + 1), color='crimson', ls='--', lw=1)\n",
    "    axes[1].text(np.log10(thr + 1), axes[1].get_ylim()[1] * 0.92, f' {lbl}', color='crimson', fontsize=7, va='top')\n",
    "axes[1].set_title('Per-feature excess kurtosis (0 = normal)')\n",
    "axes[1].set_xlabel('excess kurtosis (log-spaced)')\n",
    "axes[2].hist(np.log10(stds[stds > 0]), bins=40, color='indianred', edgecolor='white')\n",
    "axes[2].set_title('Per-feature scale (std)')\n",
    "axes[2].set_xlabel('log10(std)')\n",
    "fig.suptitle(f'Panel A — {INSPECT_EP}: the 316 raw descriptors are multi-scale and tail-heavy', y=1.03)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# --- Panel B: 4 named exemplars under each transform ---\n",
    "# ExactMolWt (large continuous), NumAromaticRings (small count), PMI3 (3D, extreme tail), TPSA (bounded-ish).\n",
