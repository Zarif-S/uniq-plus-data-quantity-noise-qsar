    "            ax.set_title(label, fontsize=10)\n",
    "        if c == 0:\n",
    "            ax.set_ylabel(f'{name}\\nskew {skews[j]:.1f} | exkurt {kurts[j]:.0f}', fontsize=8)\n",
    "fig.suptitle('Panel B — same descriptor, each transform: RobustScaler keeps the tail shape; '\n",
    "             'QuantileTransformer flattens it to [0, 1]', y=1.01)\n",
    "plt.tight_layout()\n",
    "plt.show()"
